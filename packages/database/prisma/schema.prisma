// ============================================================================
// LoanTrack — Complete Prisma Schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum LoanStatus {
  ACTIVE
  OVERDUE
  PAID
  FORGIVEN
  DISPUTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  VENMO
  PAYPAL
  CASHAPP
  CRYPTO
  OTHER
}

enum ReminderTone {
  FRIENDLY
  POLITE
  FIRM
  SERIOUS
}

enum ReminderChannel {
  PUSH
  SMS
  BOTH
}

enum TrustScoreTier {
  UNTRUSTED
  BUILDING
  RELIABLE
  TRUSTED
  EXEMPLARY
}

enum TrustScoreEventType {
  ON_TIME_REPAYMENT
  LATE_REPAYMENT
  DEFAULT_UNRESOLVED
  DISPUTE_RESOLVED_POSITIVE
  DISPUTE_RESolved_NEGATIVE
  LOAN_FORGIVEN
  STREAK_MILESTONE
  TIER_UPGRADE
  TIER_DOWNGRADE
  GENEROSITY_BONUS
  PENALTY_APPLIED
}

enum IOUStatus {
  DRAFT
  PENDING_LENDER
  PENDING_BORROWER
  SIGNED
  REVOKED
}

enum IOUSignatureMethod {
  DRAW
  TYPE
}

enum GiftOccasion {
  BIRTHDAY
  HOLIDAY
  ANNIVERSARY
  GRADUATION
  JUST_BECAUSE
  CUSTOM
}

enum StreakMilestoneBadge {
  WEEK_OF_FREEDOM
  MONTHLY_MASTERY
  QUARTERLY_CHAMPION
  HALF_YEAR_HERO
  DEBT_FREE_LEGEND
}

enum StreakResetReason {
  NEW_LOAN_CREATED
  ADMIN_RESET
}

enum NotificationType {
  LOAN_CREATED
  LOAN_ACCEPTED
  LOAN_OVERDUE
  PAYMENT_RECEIVED
  REMINDER_SENT
  LOAN_GIFTED
  STREAK_MILESTONE
  TRUST_TIER_CHANGE
  IOU_SIGNED
  LOAN_DISPUTED
}

enum NotificationChannelType {
  PUSH
  SMS
  EMAIL
  IN_APP
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone             String    @unique @db.VarChar(100)
  phoneHash         String    @unique @db.VarChar(64) // SHA-256 hash for contact lookup
  email             String?   @unique @db.VarChar(255)
  emailHash         String?   @unique @db.VarChar(64)
  displayName       String?   @db.VarChar(100)
  avatarUrl         String?   @db.VarChar(500)
  defaultCurrency   String    @default("USD") @db.VarChar(3)
  isTrustScorePublic Boolean   @default(false)
  hasPinSet          Boolean   @default(false)
  pinHash           String?   @db.VarChar(60) // bcrypt hash of local PIN
  pinAttempts       Int       @default(0)
  pinLockedUntil    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // soft delete (GDPR)
  region            String?   @db.VarChar(100)
  city              String?   @db.VarChar(100)
  preferredWallet   String?   // orange_money, moov, wave, cash, bank

  // Relations
  loansAsLender      Loan[]          @relation("LenderLoans")
  loansAsBorrower    Loan[]          @relation("BorrowerLoans")
  recordedPayments   Payment[]       @relation("RecordedBy")
  paymentCorrections PaymentCorrection[] @relation("CorrectionUser")
  voiceMemos         VoiceMemo[]    @relation("VoiceMemoUser")
  trustScore         TrustScore?
  trustScoreEvents   TrustScoreEvent[]
  relationshipEdgesAsSource  RelationshipEdge[] @relation("SourceEdges")
  relationshipEdgesAsTarget  RelationshipEdge[] @relation("TargetEdges")
  iouParties         IOUParty[]
  loanFreeStreak     LoanFreeStreak?
  giftsGiven         Gift[]          @relation("GiftsGiven")
  giftsReceived      Gift[]          @relation("GiftsReceived")
  deviceTokens       DeviceToken[]
  notificationLogs     NotificationLog[]
  reminderLogs         ReminderLog[]
  streakMilestones     StreakMilestone[]
  paymentConfirmations PaymentConfirmation[]
  disputesRaised       Dispute[]
  badges               UserBadge[]
  tontinesCreated      Tontine[]      @relation("TontineCreator")
  tontineMemberships   TontineMember[] @relation("TontineMembership")
  whatsappSessions     WhatsAppSession[] @relation("WhatsAppUser")

  @@index([phoneHash])
  @@index([emailHash])
  @@index([createdAt])
  @@map("users")
}

model Loan {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lenderId              String     @db.Uuid
  borrowerId            String     @db.Uuid
  amount                Decimal    @db.Decimal(12, 2)
  remainingBalance      Decimal    @db.Decimal(12, 2)
  currency              String     @default("USD") @db.VarChar(3)
  purpose               String     @db.VarChar(500)
  purposeCode           String?    @db.VarChar(50)
  interestRate          Decimal    @default(0) @db.Decimal(5, 2)
  collateralDescription String?
  status                LoanStatus @default(ACTIVE)
  escalationStage       Int        @default(0) // 0 = not yet, 1-4 = current stage
  dueDate               DateTime   @db.Date
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  borrowerAcceptedAt    DateTime?
  paidAt                DateTime?
  forgivenAt            DateTime?
  disputedAt            DateTime?
  disputedBy            String?    @db.Uuid
  cancelledAt           DateTime?
  deletedAt             DateTime?  // soft delete with recovery window

  // Relations
  lender              User         @relation("LenderLoans", fields: [lenderId], references: [id])
  borrower            User         @relation("BorrowerLoans", fields: [borrowerId], references: [id])
  payments            Payment[]
  reminderTemplate    ReminderTemplate?
  reminderLogs        ReminderLog[]
  attachments         Attachment[]
  digitalIOU          DigitalIOU?
  gift                Gift?
  trustScoreEvents    TrustScoreEvent[]
  paymentConfirmations PaymentConfirmation[]
  disputes            Dispute[]
  voiceMemos          VoiceMemo[]
  signedRecord        SignedRecord?

  @@index([lenderId, status])
  @@index([borrowerId, status])
  @@index([dueDate])
  @@index([status, escalationStage])
  @@index([createdAt])
  @@map("loans")
}

model Payment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId       String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(OTHER)
  status       String        @default("complete") @db.VarChar(20) // partial, complete
  note         String?       @db.VarChar(500)
  purposeTag   String?       @db.VarChar(200)
  paidAt       DateTime      @default(now())
  recordedById String        @db.Uuid
  createdAt    DateTime      @default(now())

  // Relations
  loan       Loan @relation(fields: [loanId], references: [id])
  recordedBy User @relation("RecordedBy", fields: [recordedById], references: [id])
  corrections PaymentCorrection[]
  confirmations PaymentConfirmation[]

  @@index([loanId])
  @@index([paidAt])
  @@map("payments")
}

model PaymentConfirmation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId          String    @db.Uuid
  confirmedById   String    @db.Uuid
  confirmedAt     DateTime  @default(now())
  signatureData   String?   @db.Text
  deviceInfo      String?   @db.Text
  ipAddress       String?   @db.VarChar(45)
  paymentId       String?   @db.Uuid
  status          String?   @db.VarChar(20)
  loan        Loan @relation(fields: [loanId], references: [id])
  confirmedBy User @relation(fields: [confirmedById], references: [id])
  payment     Payment? @relation(fields: [paymentId], references: [id])

  @@index([loanId])
  @@map("payment_confirmations")
}

model ReminderTemplate {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId    String         @unique @db.Uuid
  isActive  Boolean        @default(true)
  stages    ReminderStage[]

  // Relations
  loan Loan @relation(fields: [loanId], references: [id])

  @@map("reminder_templates")
}

model ReminderStage {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId       String          @db.Uuid
  level            Int
  delayDays        Int             // negative = before due date, positive = after
  tone             ReminderTone
  messageTemplate  String          @db.Text
  channel          ReminderChannel
  includeMeme      Boolean         @default(false)

  // Relations
  template ReminderTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId, level])
  @@map("reminder_stages")
}

model ReminderLog {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId       String           @db.Uuid
  sentById     String           @db.Uuid
  stage        Int
  channel      ReminderChannel
  sentAt       DateTime         @default(now())
  deliveredAt  DateTime?
  failureReason String?         @db.VarChar(500)

  // Relations
  loan   Loan @relation(fields: [loanId], references: [id])
  sentBy User @relation(fields: [sentById], references: [id])

  @@index([loanId])
  @@index([sentAt])
  @@map("reminder_logs")
}

model TrustScore {
  userId         String         @id @db.Uuid
  score          Int            @default(300)
  tier           TrustScoreTier @default(BUILDING)
  baseScore      Int            @default(300)
  repaymentBonus Int            @default(0)
  defaultPenalty Int            @default(0)
  tenureBonus    Int            @default(0)
  volumeBonus    Int            @default(0)
  badgeBonus     Int            @default(0)
  updatedAt      DateTime       @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("trust_scores")
}

model TrustScoreEvent {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String             @db.Uuid
  type            TrustScoreEventType
  delta           Int
  newScore        Int
  associatedLoanId String?           @db.Uuid
  createdAt       DateTime           @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])
  loan Loan? @relation(fields: [associatedLoanId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("trust_score_events")
}

model RelationshipEdge {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceUserId      String    @db.Uuid
  targetUserId      String    @db.Uuid
  totalLent         Decimal   @default(0) @db.Decimal(12, 2)
  totalBorrowed     Decimal   @default(0) @db.Decimal(12, 2)
  loanCount         Int       @default(0)
  onTimeCount       Int       @default(0)
  avgRepaymentDays  Decimal?  @db.Decimal(8, 2)
  lastInteractionAt DateTime? @updatedAt

  // Relations
  sourceUser User @relation("SourceEdges", fields: [sourceUserId], references: [id])
  targetUser User @relation("TargetEdges", fields: [targetUserId], references: [id])

  @@unique([sourceUserId, targetUserId])
  @@index([sourceUserId])
  @@index([targetUserId])
  @@map("relationship_edges")
}

model DigitalIOU {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId          String     @unique @db.Uuid
  iouId           String     @unique @db.VarChar(50) // Human-readable ID like "IOU-2026-ABC123"
  status          IOUStatus  @default(DRAFT)
  pdfUrl          String?    @db.VarChar(500)
  verificationUrl String     @db.VarChar(500)
  qrCodeUrl       String?    @db.VarChar(500)
  signedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  loan    Loan       @relation(fields: [loanId], references: [id])
  parties IOUParty[]

  @@map("digital_ious")
}

model IOUParty {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iouId           String             @db.Uuid
  userId          String?            @db.Uuid
  legalName       String             @db.VarChar(100)
  phone           String             @db.VarChar(100)
  signatureUrl    String?            @db.VarChar(500)
  signatureMethod IOUSignatureMethod?
  signedAt        DateTime?
  ipAddress       String?            @db.VarChar(45)
  deviceInfo      String?            @db.Text

  // Relations
  iou  DigitalIOU @relation(fields: [iouId], references: [id])
  user User?       @relation(fields: [userId], references: [id])

  @@index([iouId])
  @@map("iou_parties")
}

model LoanFreeStreak {
  userId           String             @id @db.Uuid
  currentStreak    Int                @default(0)
  longestStreak    Int                @default(0)
  lastResetAt      DateTime?
  lastResetReason  StreakResetReason?
  updatedAt        DateTime           @updatedAt
  createdAt        DateTime           @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("loan_free_streaks")
}

model StreakMilestone {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                @db.Uuid
  days       Int
  badge      StreakMilestoneBadge
  achievedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, days])
  @@index([userId])
  @@map("streak_milestones")
}

model Gift {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId      String       @unique @db.Uuid
  lenderId    String       @db.Uuid
  borrowerId  String       @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("USD") @db.VarChar(3)
  occasion    GiftOccasion
  message     String?      @db.VarChar(500)
  forgivenAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  // Relations
  loan     Loan @relation(fields: [loanId], references: [id])
  lender   User @relation("GiftsGiven", fields: [lenderId], references: [id])
  borrower User @relation("GiftsReceived", fields: [borrowerId], references: [id])

  @@index([lenderId])
  @@index([borrowerId])
  @@map("gifts")
}

model DeviceToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  token       String    @db.VarChar(500)
  platform    String    @db.VarChar(10) // ios or android
  deviceName  String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}

model NotificationLog {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @db.Uuid
  type      NotificationType
  title     String               @db.VarChar(200)
  body      String               @db.VarChar(1000)
  data      Json?
  isRead    Boolean              @default(false)
  sentAt    DateTime             @default(now())
  readAt    DateTime?
  channel   NotificationChannelType
  externalId String?             @db.VarChar(200) // FCM message ID or Twilio SID

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
  @@map("notification_logs")
}

model Attachment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId      String    @db.Uuid
  url         String    @db.VarChar(500)
  type        String    @db.VarChar(20) // image, pdf, audio
  filename    String    @db.VarChar(200)
  sizeBytes   Int
  uploadedAt  DateTime  @default(now())

  // Relations
  loan Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@map("attachments")
}
model Dispute {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId      String    @db.Uuid
  raisedBy    String    @db.Uuid
  reason      String    @db.VarChar(500)
  status      String    @default("open") // open, mediated, resolved, rejected
  resolution  String?   @db.VarChar(500)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  loan  Loan @relation(fields: [loanId], references: [id])
  raiser User @relation(fields: [raisedBy], references: [id])

  @@index([loanId])
  @@index([status])
  @@map("disputes")
}

model Badge {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code    String @unique @db.VarChar(50)
  labelFr String @db.VarChar(100)
  icon    String @db.VarChar(50)
  tier    Int    @default(1) // 1=bronze, 2=silver, 3=gold

  users  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  badgeId   String   @db.Uuid
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ============================================================================
// NEW MODELS (Souga-derived features)
// ============================================================================

model VoiceMemo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId       String   @db.Uuid
  url          String   @db.VarChar(500)
  durationSecs Int
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())
  loan         Loan     @relation(fields: [loanId], references: [id])
  recordedBy   User     @relation("VoiceMemoUser", fields: [recordedById], references: [id])
  @@index([loanId])
  @@map("voice_memos")
}

model PaymentCorrection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String   @db.Uuid
  oldAmount   Decimal  @db.Decimal(12, 2)
  newAmount   Decimal  @db.Decimal(12, 2)
  reason      String   @db.VarChar(500)
  correctedBy String   @db.Uuid
  correctedAt DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id])
  corrector   User     @relation("CorrectionUser", fields: [correctedBy], references: [id])
  @@index([paymentId])
  @@map("payment_corrections")
}

model SignedRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId      String   @unique @db.Uuid
  payloadHash String   @db.VarChar(64)
  signature   String   @db.VarChar(128)
  prevHash    String?  @db.VarChar(64)
  payload     Json
  signedAt    DateTime @default(now())
  loan        Loan     @relation(fields: [loanId], references: [id])
  @@map("signed_records")
}

model Tontine {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @db.VarChar(200)
  contributionAmount Decimal @db.Decimal(12, 2)
  currency          String   @default("XOF") @db.VarChar(3)
  frequency         String   @default("monthly") @db.VarChar(20)
  rotationOrder     String[] // phone numbers in order (canonical identifier)
  currentIdx        Int      @default(0)
  createdBy         String   @db.Uuid
  isActive          Boolean  @default(true)
  startDate         DateTime @db.Date
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creator           User     @relation("TontineCreator", fields: [createdBy], references: [id])
  members           TontineMember[]
  @@map("tontines")
}

model TontineMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tontineId   String   @db.Uuid
  userId      String?  @db.Uuid
  phone       String   @db.VarChar(20)
  displayName String?  @db.VarChar(100)
  order       Int
  hasPaid     Boolean  @default(false)
  paidAt      DateTime?
  joinedAt    DateTime @default(now())
  tontine     Tontine  @relation(fields: [tontineId], references: [id])
  user        User?    @relation("TontineMembership", fields: [userId], references: [id])
  @@unique([tontineId, phone])
  @@index([tontineId])
  @@map("tontine_members")
}

model WhatsAppSession {
  phone     String   @id @db.VarChar(20)
  userId    String?  @db.Uuid
  state     String   @default("idle") @db.VarChar(30)
  context   Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User?    @relation("WhatsAppUser", fields: [userId], references: [id])
  @@map("whatsapp_sessions")
}
